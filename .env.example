# =================================================================
# CloudResumeAI Root Environment Template
# Note: Placeholders only. Copy to .env for local development.
# Never commit real secrets or .env files to source control.
# =================================================================

# Flask Backend
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-placeholder-change-in-production
PORT=5000

# PostgreSQL Development Setup
POSTGRES_USER=cloudresume_user
POSTGRES_PASSWORD=cloudresume_password_placeholder
POSTGRES_DB=cloudresumeai_dev
POSTGRES_PORT=5432

# Microsoft Entra External ID (OIDC / JWT)
AZURE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
AZURE_ENTRA_ISSUER=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/v2.0
AZURE_ENTRA_JWKS_URI=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/discovery/v2.0/keys

# Development Identity Fallback (defaults to false in production)
DEV_AUTH_ENABLED=false
DEV_USER_EMAIL=dev@cloudresume.ai

# Google Gemini AI Integration (Strictly Backend)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-3.5-flash-lite

# Azure Storage & Database Configuration (Stage 7)
AZURE_STORAGE_MODE=local
AZURE_STORAGE_ACCOUNT_NAME=cloudresumeaistorage
AZURE_STORAGE_CONTAINER_NAME=cloudresumeai-resumes
POSTGRES_SSLMODE=prefer
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Cloud Monitoring & Telemetry (Stage 9)
LOG_LEVEL=INFO
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# Frontend Configuration
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_ENTRA_AUTHORITY=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/v2.0
VITE_AZURE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_AZURE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Azure Resource Infrastructure (Stage 7 Reference)
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_RESOURCE_GROUP=rg-cloudresumeai-dev
# AZURE_CONTAINER_REGISTRY=crcloudresumeai.azurecr.io
# AZURE_KEY_VAULT_NAME=kv-cloudresumeai-dev
# AZURE_STORAGE_ACCOUNT=cloudresumeaistorage
