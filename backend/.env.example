# ==========================================
# CloudResumeAI Backend Environment Template
# Note: Use placeholders only. Never commit real secrets.
# ==========================================

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-secret-key-in-production
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Local development default: sqlite:///cloudresume.db (zero external daemon required)
# Cloud deployment default: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///cloudresume.db
POSTGRES_USER=cloudresume_user
POSTGRES_PASSWORD=cloudresume_password_placeholder
POSTGRES_DB=cloudresumeai_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SSL mode for PostgreSQL. Use 'require' for Azure Database for PostgreSQL Flexible Server.
POSTGRES_SSLMODE=prefer

# Microsoft Entra External ID (OIDC / JWT Token Verification)
# Configured in Azure Portal / Microsoft Entra Admin Center for the Backend API
AZURE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
AZURE_ENTRA_ISSUER=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/v2.0
AZURE_ENTRA_JWKS_URI=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/discovery/v2.0/keys
# Optional PEM public key override (for offline verification or local testing)
# AZURE_ENTRA_PUBLIC_KEY=

# Development Authentication Fallback
# Defaults to false. Enabled only during local development when DEV_AUTH_ENABLED=1.
# Strictly blocked and disabled whenever FLASK_ENV=production.
DEV_AUTH_ENABLED=false
DEV_USER_EMAIL=dev@cloudresume.ai

# Google Gemini AI Integration
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Keep this key strictly secret on the backend. Never expose in frontend or client responses.
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud Storage Configuration (Supports: local, gcs, azure)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/blobs

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=cloudresumeai-resumes
GCP_SECRET_MANAGER_ENABLED=false
GOOGLE_CLIENT_ID=

# Azure Storage Configuration (Optional Reference)
AZURE_STORAGE_MODE=local
AZURE_STORAGE_ACCOUNT_NAME=cloudresumeaistorage
AZURE_STORAGE_CONTAINER_NAME=cloudresumeai-resumes
# Optional connection string (useful for local emulator/Azurite or testing).
# In production on Azure Container Apps, Managed Identity (DefaultAzureCredential) is preferred.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=placeholder;AccountKey=placeholder;EndpointSuffix=core.windows.net

# Azure Key Vault Configuration (Stage 7)
# Optional in local development; when deployed to Azure Container Apps with Managed Identity,
# secrets are resolved securely without credentials stored on disk.
# AZURE_KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Cloud Monitoring & Application Insights (Stage 9)
# In local development, leave empty to keep Application Insights telemetry inactive.
# In production on Azure, set to the Application Insights connection string.
LOG_LEVEL=INFO
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/
