# =================================================================
# CloudResumeAI Backend Environment Configuration Template
# For local setup: Copy this file to `.env` or run `..\start.bat`
# Works out-of-the-box with SQLite and Local Isolated Storage!
# =================================================================

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cloudresume-super-secret-development-key-2026-xyz
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# Local development default: sqlite:///cloudresume.db (zero daemon required)
# Cloud deployment default: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///cloudresume.db
POSTGRES_USER=cloudresume_user
POSTGRES_PASSWORD=cloudresume_password_placeholder
POSTGRES_DB=cloudresumeai_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Authentication & Identity (IAM)
# DEV_AUTH_ENABLED=true enables 1-click test personas in local dev mode.
# Strictly blocked and disabled whenever FLASK_ENV=production.
DEV_AUTH_ENABLED=true
DEV_USER_EMAIL=dev@cloudresume.ai

# Google Gemini AI Integration (Strictly Backend)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud Storage Configuration (Supports: local, gcs, azure)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/blobs

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=cloudresume-ai
GCP_REGION=us-central1
GCS_BUCKET_NAME=cloudresumeai-resumes-cloudresume-ai
GCP_SECRET_MANAGER_ENABLED=false
GOOGLE_CLIENT_ID=1009767865628-5t95t4gimdri6omss4toejicgtq8v5vm.apps.googleusercontent.com

# Microsoft Azure Configuration (Optional Reference)
AZURE_STORAGE_MODE=local
AZURE_STORAGE_ACCOUNT_NAME=cloudresumeaistorage
AZURE_STORAGE_CONTAINER_NAME=cloudresumeai-resumes
# AZURE_STORAGE_CONNECTION_STRING=

# AWS Cloud Platform Configuration (Project: Side Quest Accepted)
AWS_REGION=ap-southeast-2
AWS_PROFILE=tanmay-aws
S3_BUCKET_NAME=cloudresume-resumes-tanmay-617711904818

# AZURE_KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Cloud Monitoring & Telemetry
LOG_LEVEL=INFO
# APPLICATIONINSIGHTS_CONNECTION_STRING=
