# ==========================================
# CloudResumeAI Frontend Environment Template
# Note: Use placeholders only. Never commit real secrets.
# ==========================================

# Base URL of the backend API (leave blank when using Vite reverse proxy)
VITE_API_BASE_URL=

# Backend target for Vite dev server reverse proxy
VITE_API_PROXY_TARGET=http://localhost:5000

# Microsoft Entra External ID (Frontend SPA Registration)
# Obtain these values from Microsoft Entra Admin Center -> Applications -> App Registrations
VITE_AZURE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_ENTRA_AUTHORITY=https://<your-tenant-subdomain>.ciamlogin.com/<your-tenant-id>/v2.0
VITE_AZURE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_AZURE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
